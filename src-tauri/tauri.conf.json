{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChoiMark",
  "version": "1.0.0",
  "identifier": "com.choidev.choimark",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: http: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "choidev",
    "copyright": "© 2026 choidev",
    "category": "Productivity",
    "homepage": "https://choidev.com",
    "shortDescription": "마크다운 편집기 · 미리보기",
    "longDescription": "Windows용 마크다운 편집기와 실시간 미리보기. 탭, 파일 트리, 개요, 폴더 검색, 수식, 다이어그램, 코드 강조, HTML·PDF 내보내기를 지원합니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/markdown-file.ico": "markdown-file.ico"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdwn", "mdtxt", "mdtext"],
        "name": "ChoiMark.Markdown",
        "description": "Markdown 문서",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
